# 复制为 .env 后按需修改。默认值见 api/config/settings.py

# API_HOST=0.0.0.0
# API_PORT=8000

# 本地直连 compose 的 db（宿主机 5433）；Docker 内 api 使用 db:5432，由 compose 注入
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/recording_transcription

# 填写后 worker / SSE 走真实 LLM（OpenAI 兼容，默认 DeepSeek）
# 留空时必须 WORKER_ALLOW_MOCK_LLM=true，否则摘要阶段失败并自动重试
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 仅在没有 LLM_API_KEY 时用于占位摘要，便于一键跑通（题目说明此项会降分）
WORKER_ALLOW_MOCK_LLM=true
WORKER_MAX_CONCURRENCY=3
WORKER_LEASE_SECONDS=300
WORKER_MAX_RETRIES=3

LOG_LEVEL=INFO
LOG_JSON=true
