# 复制为 .env：cp .env.example .env
# 应用通过环境变量 / .env 加载（覆盖 api/config/settings.py 中的兜底默认值）
# 密钥只放 .env，勿提交仓库；勿给值加引号

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# ---- 数据库（本地直连 compose 映射的 5433；Docker 内由 compose 覆盖为 db:5432）----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/recording_transcription
POOL_SIZE=10
POOL_TIMEOUT=10.0

# ---- 上传（路径默认可省略，代码会用仓库根下 uploads/）----
# UPLOAD_DIR=
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=wav,mp3,m4a,aac

# ---- LLM（有 Key 走真实摘要；留空则需 WORKER_ALLOW_MOCK_LLM=true）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=3

# ---- Worker ----
WORKER_ALLOW_MOCK_LLM=true
WORKER_MAX_CONCURRENCY=3
WORKER_MAX_BATCH_SIZE=50
WORKER_LEASE_SECONDS=300
WORKER_MAX_RETRIES=3
WORKER_POLL_IDLE_SECONDS=1.0
# 显式指定则完全固定；留空则持久化到 WORKER_STATE_DIR（重启复用同一标识）
# WORKER_ID=
# WORKER_STATE_DIR=

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_JSON=true
LOG_TO_FILE=true
# LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
